                            <hr style="border: 0; border-top: 1px solid #f0f0f0; margin: 5px 0;">
                            <a href="#">Support</a>
                            <a href="#">Contact Us</a>
                            <a href="#">API Documentation</a>
                        </div>
                    </div>
                    
                    <!-- Share Button -->
                    <button class="icon-btn" id="share-trigger" title="Share">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </header>
    </div> <!-- Closing .sticky-wrapper -->

    <!-- Mobile Search Strip (Outside sticky-wrapper) -->
    <div class="search-strip">
        <div class="search-container">
            <input type="text" placeholder="Search protocol status...">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#6b7280" style="flex-shrink: 0;">
                <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
        </div>
    </div>

