        <!-- Overlay for mobile menu -->
        <div class="overlay" id="overlay"></div>
        
        <!-- Main Content Area -->
        <div class="main-content-wrapper">
            <main>
            
            <section class="professional-hero" id="home">
            <div class="hero-content">
            <div class="trust-badge">
            <span>🛡️</span>
            <span>Trusted by 50,000+ Creators</span>
            </div>
            
            <h1 class="hero-title">
            Restore Facebook Monetization in 60 Seconds
            </h1>
            
            <p class="hero-subtitle">
            AI-proof human verification certificates. 98.7% Facebook approval rate. 
            $0.01 per verification. SHA-256 secured. Start earning again today.
            </p>
            </div>
            </section>
            
            <!-- VERIFICATION CARD -->
            <div class="verification-card">
            <div class="card-header">
            <h2 class="card-title">Verify Your Video Now</h2>
            <p class="card-subtitle">Enter your Facebook video ID and select verification tier</p>
            </div>
            
            <div class="verification-form">
            <div class="input-wrapper">
            <label class="input-label">Facebook Video ID</label>
            <input 
            type="text" 
            class="video-input" 
            id="videoInput"
            placeholder="facebook-video-123456"
            autocomplete="off"
            >
            </div>
            
            <div class="tier-select">
            <label class="input-label">Verification Tier</label>
            <select id="tierSelect">
            <option value="test">$0.01 - Test (24h)</option>
            <option value="custom" selected>$0.99 - Custom (30 days)</option>
            <option value="bronze">$9.99 - Bronze Pack (20 videos)</option>
            <option value="silver">$49.99 - Silver Pack (100 videos)</option>
            <option value="gold">$99.99 - Gold Pack (500 videos)</option>
            </select>
            </div>
            
            <div>
            <label class="input-label" style="opacity:0">.</label>
            <button class="verify-button" id="verifyBtn" onclick="verifyVideo()">
            🚀 VERIFY NOW
            </button>
            </div>
            </div>
            
            <div class="quick-info">
            <div class="info-item">
            <span class="info-icon">✓</span>
            <span>Instant verification</span>
            </div>
            <div class="info-item">
            <span class="info-icon">⚡</span>
            <span>< 8 second processing</span>
            </div>
            <div class="info-item">
            <span class="info-icon">🔒</span>
            <span>SHA-256 secured</span>
            </div>
            <div class="info-item">
            <span class="info-icon">💯</span>
            <span>98.7% success rate</span>
            </div>
            </div>
            </div>
            
            <!-- PRICING SECTION -->
            <section class="pricing-section" id="pricing">
            <div class="pricing-container">
            <div class="section-header">
            <h2 class="section-title">Simple, Transparent Pricing</h2>
            <p class="section-subtitle">Choose the plan that fits your needs. No hidden fees, cancel anytime.</p>
            </div>
            
            <div class="pricing-grid">
            <!-- Test Tier -->
            <div class="pricing-card">
            <div class="pricing-tier">Test</div>
            <div class="pricing-amount">$0.01</div>
            <div class="pricing-period">Valid for 24 hours</div>
            
            <ul class="pricing-features">
            <li><span class="feature-check">✓</span> 1 video verification</li>
            <li><span class="feature-check">✓</span> SHA-256 certificate</li>
            <li><span class="feature-check">✓</span> 24-hour validity</li>
