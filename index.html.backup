    <!-- PRICING -->
<section class="newsletter" style="background:#f8fafc;padding:4rem 20px;text-align:center"><div style="max-width:600px;margin:auto"><h2 style="font-size:2rem;margin-bottom:1rem">🔔 Get Updates</h2><p>Get certificate launch notifications</p><form style="display:flex;gap:1rem;max-width:400px;margin:2rem auto"><input type="email" placeholder="your@email.com" style="flex:1;padding:1rem;border:1px solid #ddd;border-radius:8px"><button type="submit" style="padding:1rem 2rem;background:#00c851;color:white;border:none;border-radius:8px;cursor:pointer">Subscribe</button></form></div></section>
