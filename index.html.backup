    <script>
        // Navigation
        function toggleMobileNav() {
            document.getElementById('mobileNav').classList.toggle('open');
        }

        function setActiveLink(activeLink) {
            // Remove active from all main nav links
            document.querySelectorAll('.main-nav a, .nav-links a').forEach(link => {
                link.classList.remove('active');
            });
            activeLink.classList.add('active');
        }

        // Share functionality - SAME FOR INVITE CREATOR
        function sharePage() {
            if (navigator.share) {
                navigator.share({
                    title: 'SeekReap - Facebook Verification',
                    text: 'Restore Facebook monetization instantly! 98.7% success rate.',
                    url: window.location.href
                });
            } else {
                navigator.clipboard.writeText(window.location.href);
                alert('🔗 Link copied to clipboard!');
            }
        }

        function inviteCreator() {
            sharePage(); // SAME FUNCTIONALITY
        }

        // Smooth scrolling + active nav
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({behavior: 'smooth'});
                    setActiveLink(this);
                }
            });
        });

        // Set active on scroll
        window.addEventListener('scroll', () => {
            const sections = ['#home', '#about', '#whofor', '#whyexists', '#pricing'];
            const scrollPos = window.scrollY + 100;
            sections.forEach(section => {
                const el = document.querySelector(section);
                if (el && el.offsetTop <= scrollPos && (el.offsetTop + el.offsetHeight > scrollPos)) {
                    document.querySelectorAll('.main-nav a').forEach(a => a.classList.remove('active'));
                    document.querySelector(`.main-nav a[href="${section}"]`)?.classList.add('active');
                }
            });
        });

        // Video verification
        async function verifyVideo() {
            const videoId = document.getElementById('videoId').value.trim();
            const tier = document.getElementById('tierSelect').value;
            if (!videoId) {
                alert('Enter Facebook Video ID');
                return;
            }

            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(102,126,234,.95);display:flex;justify-content:center;align-items:center;z-index:1000;flex-direction:column;color:white;font-family:Inter,sans-serif;text-align:center;padding:2rem';
            overlay.innerHTML = `
                <div style="font-size:4rem;margin-bottom:1rem;">🔄</div>
                <div style="font-size:1.5rem;margin-bottom:2rem;">Verifying ${tier.toUpperCase()} Tier...</div>
                <div id="nodes" style="font-family:monospace;font-size:1rem;max-height:300px;overflow-y:auto;"></div>
            `;
            document.body.appendChild(overlay);

            const nodes = ['Cape Town','London','NYC','Toronto','Paris','Berlin','Dubai','Seoul','Amsterdam','Sydney','Tokyo','Singapore'];
            let i = 0;
            const interval = setInterval(() => {
                if (i < nodes.length) {
                    document.getElementById('nodes').innerHTML += `<div style="color:var(--success);margin:0.25rem 0;">✅ ${nodes[i]} [Verified]</div>`;
                    i++;
                }
            }, 600);

            setTimeout(() => {
                clearInterval(interval);
                document.body.removeChild(overlay);
                const certId = `SEEKREAP-${tier.toUpperCase()}-CERT-${videoId.substring(0,6).toUpperCase()}-${Date.now()}`;
                alert(`✅ CERTIFICATE GENERATED!

ID: ${certId}
Tier: ${tier.toUpperCase()}

Sign up to pay & download →

98.7% Facebook Success Rate!`);
            }, 8500);
        }

        function performSearch() {
            const query = document.getElementById('mobileSearch').value;
            alert(`Searching for: ${query}`);
        }
    </script>
</body>
</html>
