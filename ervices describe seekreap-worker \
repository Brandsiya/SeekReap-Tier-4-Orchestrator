 create_scan_job          |                                                                             +
                          | DECLARE                                                                     +
                          |     job_id bigint;                                                          +
                          | BEGIN                                                                       +
                          |     RAISE NOTICE 'Creating scan job for submission %', NEW.id;              +
                          |                                                                             +
                          |     -- Insert into pgqueuer to create a job                                 +
                          |     INSERT INTO pgqueuer (                                                  +
                          |         priority,                                                           +
                          |         entrypoint,                                                         +
                          |         payload,                                                            +
                          |         headers,                                                            +
                          |         status,                                                             +
                          |         created,                                                            +
                          |         updated,                                                            +
                          |         execute_after                                                       +
                          |     ) VALUES (                                                              +
                          |         1,  -- priority                                                     +
                          |         'process_scan',  -- entrypoint function name                        +
                          |         (jsonb_build_object(                                                +
                          |             'submission_id', NEW.id,                                        +
                          |             'scan_type', NEW.content_type                                   +
                          |         ))::text::bytea,  -- payload as bytea                               +
                          |         jsonb_build_object(                                                 +
                          |             'creator_id', NEW.creator_id,                                   +
                          |             'submitted_at', NEW.submitted_at                                +
                          |         )::text::jsonb,  -- headers as jsonb                                +
                          |         'queued'::pgqueuer_status,                                          +
                          |         NOW(),                                                              +
                          |         NOW(),                                                              +
                          |         NOW()                                                               +
                          |     ) RETURNING id INTO job_id;                                             +
                          |                                                                             +
                          |     RAISE NOTICE 'Created job % for submission %', job_id, NEW.id;          +
                          |     RETURN NEW;                                                             +
                          | END;                                                                        +
                          | 
 create_scan_job_in_queue |                                                                             +
                          | DECLARE                                                                     +
                          |     new_job_id bigint;                                                      +
                          | BEGIN                                                                       +
                          |     -- First, insert into content_submissions with ONLY columns that exist  +
                          |     INSERT INTO content_submissions (                                       +
                          |         submission_id,                                                      +
                          |         creator_id,                                                         +
                          |         content_hash,                                                       +
                          |         status,                                                             +
                          |         submitted_at,                                                       +
                          |         channel_id,                                                         +
                          |         title,                                                              +
                          |         description,                                                        +
                          |         risk_level                                                          +
                          |     )                                                                       +
                          |     VALUES (                                                                +
                          |         NEW.id,                                                             +
                          |         NEW.creator_id,                                                     +
                          |         NEW.content_hash,                                                   +
                          |         'pending',                                                          +
                          |         NOW(),                                                              +
                          |         '00000000-0000-0000-0000-000000000000'::uuid,  -- Default channel_id+
                          |         COALESCE(NEW.title, 'Untitled'),                                    +
                          |         COALESCE(NEW.description, ''),                                      +
                          |         'unknown'                                                           +
                          |     );                                                                      +
                          |                                                                             +
                          |     -- Then insert into job_queue                                           +
                          |     INSERT INTO job_queue(                                                  +
                          |         creator_id,                                                         +
                          |         content_id,                                                         +
                          |         job_type,                                                           +
                          |         params,                                                             +
                          |         submission_id,                                                      +
                          |         status,                                                             +
                          |         created_at                                                          +
                          |     )                                                                       +
                          |     VALUES (                                                                +
                          |         NEW.creator_id,                                                     +
                          |         NEW.content_hash,                                                   +
                          |         'scan',                                                             +
                          |         '{}'::jsonb,                                                        +
                          |         NEW.id,                                                             +
                          |         'pending',                                                          +
                          |         NOW()                                                               +
                          |     )                                                                       +
                          |     RETURNING job_id INTO new_job_id;                                       +
                          |                                                                             +
                          |     RAISE NOTICE 'Created job % for submission %', new_job_id, NEW.id;      +
                          |     RETURN NEW;                                                             +
                          | END;                                                                        +
